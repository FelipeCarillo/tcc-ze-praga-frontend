# Base URL of the FastAPI backend (no trailing slash).
REACT_APP_API_URL=http://localhost:8000

# Auth mode used by services/authService.js.
#   - "api"  : services hit the real backend (production behavior)
#   - "mock" : services store fake credentials in localStorage (legacy)
REACT_APP_AUTH_MODE=api

# Force services (chat, inference, history) to use in-browser mock data
# instead of the backend. Useful for offline UI development.
#   - "true"  : use mock implementations regardless of REACT_APP_AUTH_MODE
#   - "false" : use real API calls (default)
REACT_APP_USE_MOCK=false
