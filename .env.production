# Build de producao (Vercel). O CRA le este arquivo no `npm run build`.
#
# Nao guarde segredo aqui: TODA variavel REACT_APP_* e embutida no bundle
# JavaScript e fica visivel para qualquer visitante. Isto aqui e so
# configuracao publica.
#
# A URL e a do servico no Cloud Run (projeto ze-praga-tcc, regiao us-east1).
REACT_APP_API_URL=https://ze-praga-api-zwi6li6n7q-ue.a.run.app
REACT_APP_AUTH_MODE=api
REACT_APP_USE_MOCK=false
